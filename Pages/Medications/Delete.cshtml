@page "{id:int}"
@model Pharmacy_Inventory_System.Pages.Medications.DeleteModel
@{ ViewData["Title"] = "Delete Medication"; }

<h1>Delete Medication</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this medication?
</div>

<div class="card mb-3" style="max-width:500px">
    <div class="card-body">
        <h4>@Model.Medication.Name</h4>

        <img src="@Url.Content("~/" + Model.Medication.Image)"
             alt="@Model.Medication.Name"
             style="width:150px;height:150px;object-fit:cover"
             class="mb-3" />

        <p><strong>Price:</strong> @Model.Medication.Price</p>
        <p><strong>Stock Quantity:</strong> @Model.Medication.StockQuantity</p>
    </div>
</div>

<form method="post">
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
